<config>
    <modules>
        <Maho_Taler>
            <version>2.1.0</version>
        </Maho_Taler>
    </modules>

    <global>
        <models>
            <maho_taler>
                <class>Maho_Taler_Model</class>
            </maho_taler>
        </models>

        <blocks>
            <maho_taler>
                <class>Maho_Taler_Block</class>
            </maho_taler>
        </blocks>

        <helpers>
            <maho_taler>
                <class>Maho_Taler_Helper</class>
            </maho_taler>
        </helpers>

        <payment>
            <groups>
                <maho_taler>GNU Taler</maho_taler>
            </groups>
        </payment>
    </global>

    <frontend>
        <layout>
            <updates>
                <maho_taler>
                    <file>maho_taler.xml</file>
                </maho_taler>
            </updates>
        </layout>
        <secure_url>
            <maho_taler_payment>/taler/payment</maho_taler_payment>
            <maho_taler_webhook>/taler/webhook</maho_taler_webhook>
        </secure_url>
        <translate>
            <modules>
                <Maho_Taler>
                    <files>
                        <default>Maho_Taler.csv</default>
                    </files>
                </Maho_Taler>
            </modules>
        </translate>
    </frontend>

    <default>
        <maho_taler>
            <connection>
                <backend_url/>
                <instance/>
                <api_token backend_model="adminhtml/system_config_backend_encrypted"/>
                <currency/>
                <refund_delay_days>14</refund_delay_days>
                <webhook>1</webhook>
                <webhook_secret backend_model="adminhtml/system_config_backend_encrypted"/>
                <debug>0</debug>
            </connection>
        </maho_taler>
        <payment>
            <taler>
                <active>0</active>
                <model>maho_taler/method_standard</model>
                <title>GNU Taler</title>
                <group>maho_taler</group>
                <allowspecific>0</allowspecific>
                <sort_order>100</sort_order>
                <payment_page>store</payment_page>
                <payment_action>order</payment_action>
                <order_status_pending>pending_payment</order_status_pending>
                <order_status_processing>processing</order_status_processing>
            </taler>
        </payment>
        <system>
            <rate_limit>
                <taler_payment_status>30</taler_payment_status>
            </rate_limit>
        </system>
    </default>
</config>
